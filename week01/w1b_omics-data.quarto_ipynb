        "---\n",
        "title: \"Omics Data\"\n",
        "pagetitle: \"w1b: Omics Data\"\n",
        "subtitle: \"**With a focus on high-throughput sequencing data**\"\n",
        "author: Jelmer Poelstra\n",
        "date: 2025-08-26\n",
